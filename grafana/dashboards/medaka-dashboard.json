{
  "id": null,
  "uid": "medaka-monitor",
  "title": "Medaka Observation Dashboard",
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "FPS Monitor",
      "targets": [
        {
          "expr": "fps",
          "legendFormat": "FPS"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Fish Count Trend",
      "targets": [
        {
          "expr": "fish_count",
          "legendFormat": "Fish Count"
        }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6}
    },
    {
      "type": "stat",
      "title": "API Health Status",
      "targets": [
        {
          "expr": "up{job=\"medaka-api\"}",
          "legendFormat": "API Status"
        }
      ],
      "gridPos": {"x": 0, "y": 6, "w": 6, "h": 4}
    },
    {
      "type": "bargauge",
      "title": "Requests per Second",
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{status}}"
        }
      ],
      "gridPos": {"x": 6, "y": 6, "w": 6, "h": 4}
    },
    {
      "type": "heatmap",
      "title": "Request Duration (Histogram)",
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p90 latency"
        }
      ],
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 4}
    },
    {
      "type": "table",
      "title": "Bait Events",
      "targets": [
        {
          "expr": "sql_query{query=\"SELECT ts, notes FROM Observation WHERE notes LIKE 'bait%' ORDER BY ts DESC LIMIT 10\"}"
        }
      ],
      "gridPos": {"x": 0, "y": 10, "w": 24, "h": 6}
    }
  ],
  "schemaVersion": 37,
  "version": 1,
  "refresh": "10s"
}
